{
  "id": "hello-world",
  "name": "Hello World 示例插件",
  "version": "0.3.0",
  "api_version": 3,
  "manifest_version": 3,
  "author": "ST-Manager",
  "description": "插件契约 v3 活体夹具：用贡献通道（菜单树 / 插槽 / 命令）声明宿主 UI 的 5 个落点与 1 个插槽，并演示 surfaces、UI 原语、存储、配置通知与作业面板。",
  "license": "MIT",
  "backend": {
    "entry": "backend",
    "register": "register",
    "jobs": ["demo.count"],
    "hooks": ["card.updated"]
  },
  "frontend": {
    "entry": "frontend/plugin.js",
    "styles": ["frontend/plugin.css"],
    "render_mode": "declarative",
    "contributions": {
      "menus": [
        {
          "id": "main-panel",
          "placement": "dock",
          "type": "item",
          "label": "Hello",
          "description": "打开 Hello World 演示面板",
          "icon": "wand",
          "order": 10,
          "action": {
            "type": "surface",
            "id": "main"
          }
        },
        {
          "id": "modal-demo",
          "placement": "dock",
          "type": "item",
          "label": "模态",
          "description": "演示 modal 类型的宿主表面",
          "icon": "expand",
          "order": 20,
          "action": {
            "type": "surface",
            "id": "modal-demo"
          }
        },
        {
          "id": "context-card",
          "placement": "context.card",
          "type": "item",
          "label": "Hello 右键项",
          "description": "卡片右键菜单项，需先在卡片网格里选中至少一张卡片",
          "icon": "clipboard",
          "order": 50,
          "when": {
            "mode": ["cards"],
            "selection": "any"
          },
          "disabledHint": "请先选中至少一张角色卡",
          "action": {
            "type": "surface",
            "id": "main"
          }
        },
        {
          "id": "hello-batch",
          "placement": "batch.actions",
          "type": "submenu",
          "label": "Hello 批量",
          "description": "演示显式二级菜单（v2 的隐式 group 已删除）",
          "icon": "layers",
          "order": 60,
          "children": [
            {
              "id": "batch-ping",
              "type": "item",
              "label": "Hello 批量 ping",
              "description": "对选中项执行一次 ping（action 引用本插件声明的命令）",
              "icon": "bolt",
              "when": {
                "mode": ["cards"],
                "selection": "any"
              },
              "disabledHint": "请先选中至少一张角色卡",
              "action": {
                "type": "command",
                "id": "batch-ping"
              }
            },
            {
              "id": "batch-separator",
              "type": "separator"
            },
            {
              "id": "batch-refresh",
              "type": "item",
              "label": "请求宿主刷新角色卡列表",
              "icon": "refresh",
              "action": {
                "type": "command",
                "id": "refresh-list"
              }
            }
          ]
        },
        {
          "id": "hello-palette",
          "placement": "commandPalette",
          "type": "item",
          "label": "Hello 概览",
          "description": "命令面板命令；未配置问候语时置灰",
          "icon": "bolt",
          "order": 60,
          "when": {
            "config": {
              "requireKeys": ["greeting"]
            }
          },
          "disabledHint": "请先在插件设置中填写问候语",
          "action": {
            "type": "command",
            "id": "summarize"
          }
        },
        {
          "id": "settings-demo",
          "placement": "settings.nav",
          "type": "item",
          "label": "Hello 设置",
          "description": "设置页导航项：演示宿主设置页入口",
          "icon": "settings",
          "order": 40,
          "action": {
            "type": "surface",
            "id": "modal-demo"
          }
        }
      ],
      "slots": [
        {
          "id": "settings-inline",
          "slot": "settings.section",
          "title": "Hello World 设置",
          "order": 80,
          "module": "frontend/views/settingsSection.js",
          "export": "mountSettingsSection"
        }
      ],
      "commands": [
        {
          "id": "summarize",
          "title": "Hello 概览",
          "description": "命令面板命令；未配置问候语时置灰",
          "icon": "bolt",
          "shortcut": "Ctrl+Shift+H",
          "when": {
            "config": {
              "requireKeys": ["greeting"]
            }
          },
          "module": "frontend/commands.js",
          "export": "summarize"
        },
        {
          "id": "batch-ping",
          "title": "Hello 批量 ping",
          "description": "对选中项执行一次 ping",
          "icon": "bolt",
          "when": {
            "mode": ["cards"],
            "selection": "any"
          },
          "module": "frontend/commands.js",
          "export": "batchPing"
        },
        {
          "id": "refresh-list",
          "title": "Hello 刷新角色卡列表",
          "description": "请求宿主刷新角色卡列表",
          "icon": "refresh",
          "module": "frontend/commands.js",
          "export": "refreshList"
        }
      ]
    }
  },
  "capabilities": ["cards.read", "secrets.read"],
  "config_schema": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "title": "问候语",
        "description": "点击按钮前显示在面板上的文本。",
        "default": "你好，插件系统"
      },
      "show_timestamp": {
        "type": "boolean",
        "title": "显示时间戳",
        "default": true
      },
      "surface_type": {
        "type": "enum",
        "title": "演示面板类型",
        "description": "演示宿主 surface 的四种 type（panel/modal/page/sheet，由 api.surfaces.register 决定）。",
        "enum": ["panel", "modal", "page", "sheet"],
        "default": "panel"
      }
    }
  },
  "secret_schema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "示例 API Key",
        "secret": true
      },
      "base_url": {
        "type": "string",
        "title": "示例 API 地址",
        "default": "https://example.com/v1"
      }
    }
  }
}
