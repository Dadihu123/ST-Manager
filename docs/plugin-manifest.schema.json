        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "action"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "menuGrandchildSeparator": {
      "description": "分隔符：只有 id / type（根节点另需 placement）；label/action/children 会被丢弃",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "item",
            "submenu",
            "separator"
          ]
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "宿主图标名（如 `wand`）或插件内相对资源路径（如 `frontend/assets/icon.svg`）"
        },
        "order": {
          "type": "integer",
          "default": 100,
          "description": "同落点内升序建议值；默认 100"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "badge": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "静态徽标；动态值通过 api.contributions.update() 更新"
        },
        "disabledHint": {
          "type": "string",
          "description": "被 when 拦下时展示的提示"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "slot": {
      "description": "插槽渲染器：module 导出 export(container, ctx)，可返回清理函数；单插件最多 16 个",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "slot": {
          "enum": [
            "settings.section",
            "header.actions",
            "card.detail.tabs",
            "page.cards.toolbar",
            "page.worldinfo.toolbar",
            "empty.beautify",
            "empty.cards",
            "empty.chats",
            "empty.presets",
            "empty.quick_replies",
            "empty.regex",
            "empty.scripts",
            "empty.worldinfo"
          ],
          "description": "命名插槽，或 `empty.<mode>` 空状态插槽"
        },
        "title": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 100
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "module": {
          "$ref": "#/$defs/relativePath"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      },
      "required": [
        "id",
        "slot",
        "module",
        "export"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "command": {
      "description": "命令：菜单 action 与命令面板都可触发；module 导出 export(ctx)；单插件最多 32 个",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "shortcut": {
          "type": "string",
          "pattern": "^(?:Ctrl|Control|Alt|Option|Meta|Cmd|Command|Super|Win|Shift)(?:\\+(?:Ctrl|Control|Alt|Option|Meta|Cmd|Command|Super|Win|Shift))*\\+(?:[A-Za-z0-9]|F(?:[1-9]|1[0-2])|Escape|Enter|Space|Tab|Backspace|Delete|Home|End|PageUp|PageDown|ArrowUp|ArrowDown|ArrowLeft|ArrowRight)$",
          "description": "形如 Ctrl+Shift+D；必须含 Ctrl/Alt/Meta 之一（Shift 单独不算），同插件内不得重复"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "module": {
          "$ref": "#/$defs/relativePath"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      },
      "required": [
        "id",
        "title",
        "module",
        "export"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "contributions": {
      "description": "三原语：菜单树（menus）/ 插槽（slots）/ 命令（commands）",
      "type": "object",
      "properties": {
        "menus": {
          "description": "菜单树根节点。宿主按**节点总数**计数：单插件最多 64 个节点（含子节点）、最多 3 层",
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/menuRootItem"
              },
              {
                "$ref": "#/$defs/menuRootSubmenu"
              },
              {
                "$ref": "#/$defs/menuRootSeparator"
              }
            ]
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "backend": {
      "description": "后端入口声明（与 v2 语义一致）",
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "后端包相对路径（如 backend）"
        },
        "register": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "default": "register"
        },
        "jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        },
        "hooks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "x-known-hooks": [
              "app.ready",
              "card.created",
              "card.deleted",
              "card.moved",
              "card.updated",
              "index.job_done",
              "scan.completed",
              "tag.applied",
              "tag.deleted",
              "worldbook.entry_changed",
              "worldbook.saved"
            ],
            "description": "未知 hook 宿主忽略并警告（strict CLI 也允许）"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "frontend": {
      "description": "前端声明；frontend.entries 与 permissions 已删除（不保留别名）",
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "前端入口模块（ES module，导出 activate(api)，可选 deactivate(api)）"
        },
        "styles": {
          "description": "受作用域约束的样式（.plugin-<id> 或 [data-plugin=\"<id>\"] 根作用域）",
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "global_styles": {
          "description": "免作用域全局样式；需要 ui.global_styles 能力位（宿主拒绝注入）",
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "render_mode": {
          "enum": [
            "declarative",
            "custom"
          ],
          "default": "declarative",
          "description": "custom 表示插件自绘界面；需要 ui.custom 能力位（披露，非审批）"
        },
        "contributions": {
          "$ref": "#/$defs/contributions"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "formField": {
      "description": "表单字段；允许键 = contract.SCHEMA_ALLOWED_KEYS（10 个）",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "enum",
            "integer",
            "number",
            "string"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "secret": {
          "type": "boolean"
        },
        "required": {
          "description": "保留键（宿主当前不处理）",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "description": "保留键（宿主当前不处理）"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
    "formSchema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/formField"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "config_schema / secret_schema 的简化表单 schema；未知顶层键宿主静默忽略，因此这里不设 additionalProperties: false"
    }
  }
}
