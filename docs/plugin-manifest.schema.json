              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "静态徽标；动态值通过 api.contributions.update() 更新"
        },
        "disabledHint": {
          "type": "string",
          "description": "被 when 拦下时展示的提示"
        },
        "placement": {
          "enum": [
            "context.folder",
            "context.card",
            "context.footer",
            "batch.actions",
            "commandPalette",
            "dock",
            "settings.nav"
          ],
          "description": "仅根节点必填；子节点由根节点决定落点（写 placement 会被丢弃）"
        },
        "children": {
          "description": "子节点；整棵树最多 3 层（含根节点）",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/menuChildItem"
              },
              {
                "$ref": "#/$defs/menuChildSubmenu"
              },
              {
                "$ref": "#/$defs/menuChildSeparator"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "placement",
        "type",
        "label",
        "children"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {
          "description": "实验键（`x-` 前缀）：宿主静默忽略（设计 §4.9）"
        }
      }
    },
