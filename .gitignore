__pycache__/
*.pyc
*.pyo
*.pyd
.db
.git/
.vscode/
# 忽略 data 下所有直接子项
data/*
# 但保留 assets 目录（否则 Git 不会进入）
!data/assets/
# 忽略 assets 下的所有内容
data/assets/*
# 但保留 backgrounds 目录
!data/assets/backgrounds/
# 忽略 backgrounds 下的所有内容
data/assets/backgrounds/*
# 只保留目标文件
!data/assets/backgrounds/default_background.jpeg
config.json
venv/
env/
node_modules/
dist/
build/
tmp/
dsh-image-gen/
*.exe
*.spec
# 忽略打包环境产生的临时文件
gui.log
app.log

# Local forum update probe responses may contain private forum content
artifacts/forum_update_probe/

cards_metadata.db*

# 测试和文档目录
discord/
.worktrees/
.superpowers/
docs/superpowers

# ---------------------------------------------------------------------------
# docs/：默认整体不跟踪，只单独放行长期维护的文档。
#
# 约定：设计稿、方案、可行性分析、审计、实现日志、prompt 这类临时产物
# 只保留在本地，不进 Git（文件名带日期的 `docs/2026-*.md` 基本都是这一类）。
# 需要跟踪的只有下面这些「对外文档 + 生成物 + 治理文档」。
#
# 注意：Git 无法重新包含已被排除目录中的文件，所以放行目录时必须
# 先放行目录本身（`!docs/xxx/`），再放行其内容（`!docs/xxx/**`）。
# ---------------------------------------------------------------------------
docs/*
# README 用的图标与截图
!docs/readme-icons/
!docs/readme-icons/**
!docs/screenshots/
!docs/screenshots/**
# 长期维护的手写文档
!docs/API.md
!docs/CONFIG.md
!docs/DEVELOPMENT.md
!docs/plugin-api.md
!docs/svg-icon-system.md
# 生成物：CI 与测试断言其存在，且 `--check` 必须能比对
!docs/plugin-manifest.schema.json
!docs/plugin-api.d.ts
# 治理文档：AGENTS.md 与 plugin-api.md 指向这里
!docs/adr/
!docs/adr/**
!docs/agents/
!docs/agents/**
!docs/plugin-migration-v2-to-v3.md

# ---------------------------------------------------------------------------
# Android 壳工程（android/）：仓库跟踪源码与配置，忽略构建产物
# ---------------------------------------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/src/main/python/**/__pycache__/
android/captures/
*.apk
*.aab

# pip 在 android/app 下留下的临时工作目录（Chaquopy 调 pip 安装依赖时产生）。
# 里面是 wheel/metadata 的临时副本，每次构建都会重建，绝不能提交。
android/app/pip-*/

# 离线依赖 wheelhouse：由 tools/build_android_wheelhouse.py 生成。
# 不入库的原因：15 个 wheel 共 2.4 MB 二进制，且**可完全重建**；
# 提交二进制会让仓库膨胀且难以审阅。CI 在构建前跑该脚本自动生成。
# 本地首次构建前也先跑一次：
#   python tools/build_android_wheelhouse.py
android/wheelhouse/
